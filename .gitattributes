# Keep LF endings in build and source files; CRLF breaks shell-style
# entrypoints and container builds.
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.conf text eol=lf
*.css text eol=lf
*.html text eol=lf
Dockerfile text eol=lf
.dockerignore text eol=lf

*.png binary
*.ico binary
*.wav binary
