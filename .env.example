# SessionIQ answer engine - pick ONE option below (or none).
# With neither configured, SessionIQ uses its built-in offline rules engine.

# Option A: local AI with Ollama (free, private; install from https://ollama.com,
# then run: ollama pull llama3.2)
#OPENAI_BASE_URL=http://localhost:11434/v1
#SESSIONIQ_MODEL=llama3.2

# Option B: OpenAI cloud
#OPENAI_API_KEY=sk-your-key-here
#SESSIONIQ_MODEL=gpt-4.1-mini

# Optional components (never bundled; install what you want):
#
# Semantic vector search  -> pip install -e ".[vector]"   (local ChromaDB)
# Voice memo transcription -> pip install -e ".[voice]"   (local Whisper)

# Whisper model for voice memo transcription (downloads to your user cache
# on first use). "base.en" is fast; "small.en"/"medium" trade speed for accuracy.
#SESSIONIQ_WHISPER_MODEL=base.en

# Set to any value to force lexical-only retrieval even when chromadb is installed.
#SESSIONIQ_DISABLE_VECTOR=1

# Integrated-loudness target (LUFS) for the "Master loudness on target"
# readiness check. -14 suits most streaming platforms.
#SESSIONIQ_LUFS_TARGET=-14
